# Zugang zum selbst gehosteten Supabase-Server (SSH). Kopie dieser Datei nach `.env.db` anlegen
# und ausfuellen — `.env.db` ist gitignored und bleibt lokal.
#
# Genutzt von: npm run db:push:server, db:status:server, functions:deploy:server,
#              pptx-renderer:deploy:server, project:push / project:pull

# PFLICHT — SSH-Ziel, wie du es auch an `ssh` uebergeben wuerdest.
DB_SSH_TARGET=benutzer@server.example.com

# Optional — nur setzen, wenn der Server vom Standard-Layout abweicht.
# DB_SSH_DOCKER_DIR=~/supabase/docker
# DB_SSH_FUNCTIONS_DIR=~/supabase/docker/volumes/functions
# DB_SSH_REMOTE_DIR=/tmp/straton-supabase-push
# DB_SSH_PROJECT_DIR=~/straton
# DB_SSH_PPTX_RENDERER_DIR=~/pptx-renderer
